# Bastion environment configuration example
# Copy this file to .env and fill in the required values.
# The .env file is never committed to version control.

# ── Core ──────────────────────────────────────────────────────────────────────
# Required. Generate with: python3 -c "import secrets; print(secrets.token_hex(64))"
# Never change this after first use — it invalidates all tokens and encrypted secrets.
SECRET_KEY=

ENVIRONMENT=production
HA_MODE=false
NODE_ID=node-1

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (single node, default):
DB_BACKEND=sqlite
DB_URL=sqlite+aiosqlite:////opt/bastion/data/bastion.db

# PostgreSQL (HA mode):
# DB_BACKEND=postgres
# DB_URL=postgresql+asyncpg://bastion:password@db-host:5432/bastion

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── SSH CA ────────────────────────────────────────────────────────────────────
SSH_CERT_VALIDITY_HOURS=8

# ── Session recordings ────────────────────────────────────────────────────────
RECORDINGS_ENABLED=true
RECORDINGS_STORAGE=local
# RECORDINGS_STORAGE=s3
# RECORDINGS_S3_BUCKET=my-bastion-recordings
# RECORDINGS_S3_PREFIX=bastion/recordings/

# age public key for asymmetric recording encryption.
# Generate with: age-keygen
# Store the private key offline — it is required to decrypt recordings.
# RECORDINGS_AGE_PUBLIC_KEY=age1...

# ── 2FA ───────────────────────────────────────────────────────────────────────
TOTP_ISSUER=Bastion
MFA_EMAIL_CODE_EXPIRE_MINUTES=10

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_AUTH_PER_MINUTE=10

# ── Anomaly detection ─────────────────────────────────────────────────────────
ANOMALY_SCORE_ALERT_THRESHOLD=70

# ── Package checks ────────────────────────────────────────────────────────────
PACKAGE_CHECK_INTERVAL_HOURS=6

# ── Alerting — SMTP ───────────────────────────────────────────────────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=alerts@example.com
# SMTP_PASSWORD=
# SMTP_FROM_ADDRESS=bastion-alerts@example.com
# SMTP_USE_TLS=true

# ── Alerting — AWS SES ────────────────────────────────────────────────────────
# SES_REGION=eu-west-1
# SES_FROM_ADDRESS=bastion-alerts@example.com

# ── Alerting — Slack ──────────────────────────────────────────────────────────
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# ── Alerting — PagerDuty ──────────────────────────────────────────────────────
# PAGERDUTY_INTEGRATION_KEY=

# ── Alerting — Pushover ───────────────────────────────────────────────────────
# PUSHOVER_APP_TOKEN=
# PUSHOVER_USER_KEY=
