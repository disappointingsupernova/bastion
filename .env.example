# Bastion environment configuration example
# Copy this file to .env and fill in the required values.
# The .env file is never committed to version control.

# ── Core ──────────────────────────────────────────────────────────────────────
# Required. Generate with: python3 -c "import secrets; print(secrets.token_hex(64))"
# Never change this after first use — it invalidates all tokens and encrypted secrets.
SECRET_KEY=

ENVIRONMENT=production
HA_MODE=false
NODE_ID=node-1

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (single node, default):
DB_BACKEND=sqlite
DB_URL=sqlite+aiosqlite:////opt/bastion/data/bastion.db

# PostgreSQL (HA mode):
# DB_BACKEND=postgres
# DB_URL=postgresql+asyncpg://bastion:password@db-host:5432/bastion

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── SSH CA ────────────────────────────────────────────────────────────────────
SSH_CERT_VALIDITY_HOURS=8

# Passphrase used to encrypt the CA private key at rest.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Required if the CA key was generated with a passphrase (recommended).
# CA_KEY_PASSPHRASE=

# ── Session recordings ────────────────────────────────────────────────────────
RECORDINGS_ENABLED=true
RECORDINGS_STORAGE=local
# RECORDINGS_STORAGE=s3
# RECORDINGS_S3_BUCKET=my-bastion-recordings
# RECORDINGS_S3_PREFIX=bastion/recordings/

# age public key for asymmetric recording encryption.
# Generate with: age-keygen
# Store the private key offline — it is required to decrypt recordings.
# RECORDINGS_AGE_PUBLIC_KEY=age1...

# Master key for deriving per-admin recording decrypt keys.
# Each admin gets a unique key derived from this master via HMAC-SHA256.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# RECORDINGS_MASTER_KEY=

# ── 2FA ───────────────────────────────────────────────────────────────────────
TOTP_ISSUER=Bastion
MFA_EMAIL_CODE_EXPIRE_MINUTES=10

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_AUTH_PER_MINUTE=10

# ── Anomaly detection ─────────────────────────────────────────────────────────
ANOMALY_SCORE_ALERT_THRESHOLD=70

# ── Dual approval ─────────────────────────────────────────────────────────────
# When true, privileged actions (sudo grants, cert revocation, user deletion)
# require a second admin to confirm within DUAL_APPROVAL_WINDOW_MINUTES.
# When only one admin exists, the initiator must re-verify with TOTP + email.
# Set to false (default) for single-admin deployments.
DUAL_APPROVAL_REQUIRED=false
DUAL_APPROVAL_WINDOW_MINUTES=30

# ── Package checks ────────────────────────────────────────────────────────────
PACKAGE_CHECK_INTERVAL_HOURS=6

# ── SSH key rotation reminders ────────────────────────────────────────────────
# Alert when a user's SSH public key has not been rotated in this many days.
SSH_KEY_MAX_AGE_DAYS=365

# ── Certificate expiry warnings ───────────────────────────────────────────────
# Warn this many minutes before a certificate expires (0 = disabled).
CERT_EXPIRY_WARN_MINUTES=60

# ── LDAP / Active Directory ───────────────────────────────────────────────────
# LDAP_URL=ldap://dc.example.com:389
# LDAP_BIND_DN=CN=bastion,OU=ServiceAccounts,DC=example,DC=com
# LDAP_BIND_PASSWORD=
# LDAP_USER_BASE_DN=OU=Users,DC=example,DC=com
# LDAP_USER_FILTER=(objectClass=person)
# LDAP_USERNAME_ATTR=sAMAccountName
# LDAP_EMAIL_ATTR=mail
# LDAP_SYNC_INTERVAL_HOURS=6

# ── SIEM / syslog forwarding ──────────────────────────────────────────────────
# SYSLOG_HOST=siem.example.com
# SYSLOG_PORT=514
# SYSLOG_PROTOCOL=udp
# SYSLOG_FACILITY=16

# ── Webhook notifications ─────────────────────────────────────────────────────
# WEBHOOK_URL=https://hooks.example.com/bastion
# WEBHOOK_SECRET=

# ── Alerting — SMTP ───────────────────────────────────────────────────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=alerts@example.com
# SMTP_PASSWORD=
# SMTP_FROM_ADDRESS=bastion-alerts@example.com
# SMTP_USE_TLS=true

# ── Alerting — AWS SES ────────────────────────────────────────────────────────
# SES_REGION=eu-west-1
# SES_FROM_ADDRESS=bastion-alerts@example.com

# ── Alerting — Slack ──────────────────────────────────────────────────────────
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# ── Alerting — PagerDuty ──────────────────────────────────────────────────────
# PAGERDUTY_INTEGRATION_KEY=

# ── Alerting — Pushover ───────────────────────────────────────────────────────
# PUSHOVER_APP_TOKEN=
# PUSHOVER_USER_KEY=
